# =====================================================================================================
# Intelli-Credit configuration. Copy to `.env` (repository root) and adjust. NEVER commit real secrets.
# Every variable is optional for local development unless marked REQUIRED; defaults are shown.
# Missing third-party credentials never stop the app — the integration reports "not configured".
# =====================================================================================================

# ---------------------------------------------------------------- Core
# development | test | production. Production refuses to start with insecure settings (see below).
ENVIRONMENT=development
# REQUIRED in production: random string >= 32 chars used to sign session tokens (JWT, HS256).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# Session lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Allow self-service sign-up that creates a new organisation (the registrant becomes its admin).
ALLOW_REGISTRATION=false
# Comma-separated browser origins allowed by CORS (the Next.js proxy makes most calls same-origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Session cookie flags. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_NAME=ic_session
# Logging: json (structured, for log shippers) or text (local). Request bodies/documents are never logged.
LOG_FORMAT=json
LOG_LEVEL=INFO
# ---------------------------------------------------------------- Rate limiting (app/core/ratelimit.py)
# Redis token buckets shared by every API instance (atomic Lua; Redis server time). "memory" = per process only.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
# Redis for rate limits and the failed-login lockout (blank = REDIS_URL).
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_KEY_PREFIX=ic:rl
# While Redis is unreachable: local (keep enforcing per process — default), open (allow), closed (reject with 503).
RATE_LIMIT_FAIL_MODE=local
# Seconds to skip Redis after a failure (circuit breaker) before trying again.
RATE_LIMIT_BREAKER_SECONDS=5
# Redis connect/reply timeout in ms; a slower store counts as unavailable (the fail mode above applies).
RATE_LIMIT_REDIS_TIMEOUT_MS=300
# Limits are "N/period" with period second|minute|hour|day (e.g. 20/10minute).
# Unauthenticated requests per client IP (blank = RATE_LIMIT_PER_MINUTE/minute) and login/registration per IP.
RATE_LIMIT_IP=
RATE_LIMIT_AUTH=
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
# Authenticated requests per user and per organisation.
RATE_LIMIT_USER=600/minute
RATE_LIMIT_ORG=3000/minute
# Extra buckets for expensive endpoints: AI (assistant, research, provider tests) and document processing /
# analysis (uploads, re-processing, reconciliation, assessment, CAM).
RATE_LIMIT_AI_USER=20/minute
RATE_LIMIT_AI_ORG=100/minute
RATE_LIMIT_PROCESSING_USER=60/minute
RATE_LIMIT_PROCESSING_ORG=300/minute
# Proxies whose X-Forwarded-For header is trusted (CIDRs). Include the frontend container network in Docker.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ---------------------------------------------------------------- Database (PostgreSQL 16 + pgvector)
# Connection used by the API and worker. Use the NON-superuser role so row-level security applies.
DATABASE_URL=postgresql+psycopg://intellicredit_app:CHANGE_ME_APP_ROLE_PASSWORD@localhost:5433/intellicredit
# Owner/superuser connection used ONLY for `alembic upgrade head` and `python -m app.cli create-app-role`.
# Defaults to DATABASE_URL when empty.
MIGRATION_DATABASE_URL=postgresql+psycopg://intelli:intelli_dev_pw@localhost:5433/intellicredit
# Name and password of the application role created by `python -m app.cli create-app-role`.
DB_APP_ROLE=intellicredit_app
APP_DB_PASSWORD=CHANGE_ME_APP_ROLE_PASSWORD

# ---------------------------------------------------------------- Background jobs
# celery (Redis worker: `celery -A app.workers.celery_app worker`), thread (in-process pool), sync (tests).
JOB_BACKEND=thread
REDIS_URL=redis://localhost:6380/0
# Attempts per job before it is marked failed; thread-pool size; minutes before a 'running' job is re-queued.
JOB_MAX_ATTEMPTS=3
JOB_THREAD_WORKERS=2
JOB_STALE_MINUTES=30

# ---------------------------------------------------------------- Private document storage
# Directory outside any web root (blank = backend/storage; relative paths are from the repo root).
# Files are only streamed through authorised API endpoints.
STORAGE_DIR=
# Maximum upload size in MB (enforced on Content-Length and while streaming the upload).
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- LLM (optional) — Anthropic Claude
# anthropic | none. With "none", the assistant and narratives use deterministic extractive output.
LLM_PROVIDER=none
# Anthropic API key (server-side only; never sent to the browser).
LLM_API_KEY=
# Model id. Scores, amounts and rates are always computed in code, never by the model.
LLM_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------- Embeddings for document search (RAG)
# local-hash (no network; lexical hashing, default) | voyage | sentence-transformers
EMBEDDING_PROVIDER=local-hash
# hash-384 for local-hash; e.g. voyage-3.5 for Voyage; a model name for sentence-transformers.
EMBEDDING_MODEL=hash-384
# Voyage AI API key (only for EMBEDDING_PROVIDER=voyage).
EMBEDDING_API_KEY=

# ---------------------------------------------------------------- External research (optional)
# none | tavily | brave | serpapi. Without a provider, research is recorded as
# "No verified external research available: provider not configured." and nothing is presented as verified.
SEARCH_PROVIDER=none
# Key for the active SEARCH_PROVIDER (used when its specific key below is blank).
SEARCH_API_KEY=
# Per-provider keys: each provider can be connection-tested independently in Settings -> API configuration.
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
# Results requested per query.
SEARCH_MAX_RESULTS=6

# ---------------------------------------------------------------- OCR for scanned PDFs / images
# auto (Tesseract if installed, else RapidOCR) | tesseract | rapidocr | none
OCR_PROVIDER=auto
# Tesseract language code(s), e.g. eng or eng+hin.
OCR_LANG=eng

# ---------------------------------------------------------------- Databricks (optional, not used by the core workflow)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# ---------------------------------------------------------------- ML challenger (experimental)
# Shown next to the policy scorecard for comparison only; never changes scores, amounts or rates.
CHALLENGER_ENABLED=true
# Artifact root (blank = backend/models/challenger) and version (blank = the version named in <dir>/LATEST).
CHALLENGER_MODEL_DIR=
CHALLENGER_MODEL_VERSION=

# ---------------------------------------------------------------- Demo data
# Show demo affordances. Seeded data is always labelled synthetic regardless of this flag.
DEMO_MODE=true
# Where `python -m app.cli seed` writes the synthetic documents (default: <repo>/data/synthetic).
SYNTHETIC_DATA_DIR=
# Password for seeded demo users. Defaults to the development value documented in README.md;
# REQUIRED if you seed in ENVIRONMENT=production (not recommended).
DEMO_PASSWORD=

# ---------------------------------------------------------------- Frontend (Next.js)
# Where the Next.js server proxies /api/* (baked in at build time for production builds).
BACKEND_URL=http://127.0.0.1:8001
# /api proxy limits, read when `next build` runs (the Docker image is built with these defaults): request timeout
# in ms and maximum request body in MB. Keep the body limit at
# MAX_UPLOAD_MB + 1 and any reverse proxy (nginx client_max_body_size / proxy_read_timeout) in line with both.
API_PROXY_TIMEOUT_MS=180000
API_PROXY_MAX_BODY_MB=26

# ---------------------------------------------------------------- Docker Compose host ports (optional)
IC_WEB_PORT=3080
IC_API_PORT=8080
IC_DB_PORT=5435
POSTGRES_USER=intelli
# Database owner password (blank = Compose development default; set a strong value for anything shared).
POSTGRES_PASSWORD=
POSTGRES_DB=intellicredit
