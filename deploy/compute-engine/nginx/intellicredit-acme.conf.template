# Temporary HTTP-only site used by setup-nginx.sh to obtain the first Let's Encrypt certificate.
# Replaced by intellicredit.conf.template as soon as the certificate exists. It does not proxy the application:
# the app's cookies are Secure-only, so it is never served over plain HTTP.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 503 "Intelli-Credit: HTTPS is being configured.\n";
    }
}
